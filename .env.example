WIFI_NAME=your-2.4-ghz-network
PASSWORD=your-wifi-password

# Optional MQTT and common-cathode RGB LED settings.
# MQTT_HOST defaults to the build computer's current LAN address.
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_TOPIC=lights/rgb
RGB_RED_PIN=32
RGB_GREEN_PIN=33
RGB_BLUE_PIN=25
RGB_COMMON_ANODE=false
STATUS_LED_PIN=2
STATUS_LED_ACTIVE_LOW=false
